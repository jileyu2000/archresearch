{
  "manifest_version": 3,
  "name": "ArchResearch Browser Bridge",
  "version": "0.1.0",
  "description": "Local browser bridge for evidence-based architecture research.",
  "permissions": ["storage", "tabs", "scripting", "activeTab", "sidePanel"],
  "optional_host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "ArchResearch",
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
