{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "ArchResearch Chrome 扩展",
  "version": "2.2.9",
  "description": "Controlled Chrome bridge for evidence-based architecture research.",
  "permissions": ["storage", "tabs", "scripting", "activeTab", "sidePanel", "alarms"],
  "optional_host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*", "http://localhost/*"],
      "js": ["assets/boardBridge.js"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "ArchResearch Chrome 扩展",
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
