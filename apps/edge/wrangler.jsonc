{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "archresearch-web",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "workflows": [
    {
      "name": "archresearch-research",
      "binding": "RESEARCH_WORKFLOW",
      "class_name": "ResearchWorkflow"
    }
  ],
  "r2_buckets": [
    {
      "binding": "VISUAL_PREVIEWS",
      "bucket_name": "archresearch-visual-previews"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "COST_GUARD",
        "class_name": "CostGuardDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CostGuardDurableObject"]
    }
  ],
  "ratelimits": [
    {
      "name": "START_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 6,
        "period": 60
      }
    }
  ],
  "vars": {
    "PROVIDER_BASE_URL": "https://suoxie.codes/v1",
    "PROVIDER_MODEL": "gpt-5.6-sol",
    "PROVIDER_INPUT_USD_PER_MILLION": "5",
    "PROVIDER_OUTPUT_USD_PER_MILLION": "20",
    "WEB_SEARCH_CALL_USD": "0.03",
    "SERVICE_ENABLED": "true",
    "MOCK_MODE": "false"
  },
  "secrets": {
    "required": [
      "PROVIDER_API_KEY",
      "TURNSTILE_SITE_KEY",
      "TURNSTILE_SECRET_KEY",
      "ADMIN_CONTROL_TOKEN"
    ]
  }
}
